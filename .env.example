# 系統執行環境 (development / production)
NODE_ENV=development

# 後端伺服器聆聽 Port (預設 5000)
PORT=5000

# [安全] JWT 簽署金鑰 (若不設定，系統將於每次啟動自動產生安全的 256 位元隨機亂數)
# JWT_SECRET=your_super_secret_jwt_key_here

# OpenAI API Key (供合約五維度智能解析使用)
OPENAI_API_KEY=

# Google Gemini API Key (供合約五維度智能解析使用 - 與 OpenAI 擇一設定即可)
GEMINI_API_KEY=

# MS Teams Webhook URL (供每日背景排程稽核發布通知使用)
TEAMS_WEBHOOK_URL=
